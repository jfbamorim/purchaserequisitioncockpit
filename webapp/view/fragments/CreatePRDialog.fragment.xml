<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout">
    <Dialog contentHeight="75%"
        contentWidth="85%"
        resizable="true"
        draggable="true">
        <form:SimpleForm id="simplePRForm" editable="true" title="Create PR" layout="ResponsiveGridLayout" singleContainerFullSize="false"> 
            <form:content>
				<Label text="Description" />
				<Input id="prDescription" value="{createModel>/header/Txz01}"/>
				<Label text="PR Type" />
				<Input id="prType" value="{createModel>/header/Bsart}" editable="false"/>
				<Label text="Plant destiny" />
                <Input value="{createModel>/header/Reswk}" showValueHelp="true" valueHelpRequest=".onPlantValueHelp"/>
				<Label text="Purchasing Group" />
				<Input id="purchasingGroup" value="{createModel>/header/Ekorg}" showValueHelp="true" valueHelpRequest=".onPurchaseGroupValueHelp"/>
				<Label text="PR Priority" />
                <Select selectedKey="{createModel>/header/Dringlichkeit}">
                    <core:Item key="1" text="Alta"/>
                    <core:Item key="2" text="Média"/>
                    <core:Item key="3" text="Baixa"/>
                </Select>
				<Label text="PR Notes" />
				<Input id="prNotes" value="{createModel>/header/Notes}"/>
            </form:content>
        </form:SimpleForm>
        <Table id="prItens" items="{createModel>/items}">
            <columns>
                <Column> <Text text="Item Description" /> </Column>
                <Column> <Text text="Material" /> </Column>
                <Column> <Text text="Quantity" /> </Column>
                <Column> <Text text="Unit" /> </Column>
                <Column> <Text text="Delivery Date" /> </Column>
                <Column> <Text text="Cost Center" /> </Column>
                <Column> <Text text="Material Group" /> </Column>
                <Column> <Text text="Preferred Vendor" /> </Column>
                <Column> <Text text="Estimated Price" /> </Column>
                <Column> <Text text="Currency" /> </Column>
            </columns>
            <items>
                <ColumnListItem editable="true">
                    <cells>
                        <Input value="{createModel>Txz01}"/>
                        <Input value="{createModel>Matnr}"/>
                        <Input value="{createModel>Menge}"/>
                        <Input value="{createModel>Meins}"/>
                        <Input value="{createModel>Lfdat}"/>
                        <Input value="{createModel>Kostl}"/>
                        <Input value="{createModel>Matkl}"/>
                        <Input value="{createModel>Lifnr}"/>
                        <Input value="{createModel>Preis}"/>
                        <Input value="{createModel>Waers}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <Button text="+ Add Item" press=".onAddItem" type="Ghost"/>
        <buttons>
            <Button text="Submit" type="Emphasized" press=".onSubmitPR"/>
            <Button text="Cancel" press=".onCancelPR"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>